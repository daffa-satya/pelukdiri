    <string name="onboarding_perm_accessibility_title">Enable Accessibility</string>
    <string name="onboarding_perm_accessibility_desc">Accessibility is needed by PELUKDIRI to detect apps and run interventions.</string>
    <string name="onboarding_perm_usage_title">Usage Access</string>
    <string name="onboarding_perm_usage_desc">Usage access is required so PELUKDIRI can accurately calculate your screen time.</string>
    <string name="onboarding_perm_notif_title">Notifications</string>
    <string name="onboarding_perm_notif_desc_v2">Enable notifications so you don\'t miss reminders and daily summaries.</string>
