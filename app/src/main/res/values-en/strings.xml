    <string name="onboarding_perm_accessibility_title">Grant Accessibility</string>
    <string name="onboarding_perm_accessibility_desc">Accessibility is needed by CelfCare to detect apps and execute interventions.</string>
    <string name="onboarding_perm_usage_title">Usage Access</string>
    <string name="onboarding_perm_usage_desc">Usage access is required for CelfCare to accurately calculate your screen time.</string>
    <string name="onboarding_perm_notif_title">Notifications</string>
