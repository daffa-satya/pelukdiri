    <string name="onboarding_how_label">HOW IT WORKS</string>
    <string name="onboarding_how_title">Adaptive interventions, not just blocking</string>
    <string name="onboarding_how_desc">When you open a monitored app, CelfCare will present a challenge to help you pause and think.</string>
    <string name="onboarding_how_step_title">How CelfCare helps you</string>
    <string name="onboarding_how_step_1">You open or use a monitored app</string>
    <string name="onboarding_how_step_2">A short challenge matching your ability appears</string>
